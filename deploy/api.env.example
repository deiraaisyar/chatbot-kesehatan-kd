# Copy to /etc/health/api.env and chmod 600.
# Generate a token with: openssl rand -hex 32
HEALTH_API_TOKEN=change-me

# Paths on the Pi. The repository is expected at /opt/health.
RISK_MODEL_DIR=/opt/health/models
META_PATH=/opt/health/data/final/meta.json
RISK_LEVELS_PATH=/opt/health/data/final/risk_levels.json
DASHBOARD_DIR=/opt/health/dashboard/dist

# Local llama.cpp server (never expose this port to the LAN).
CHAT_BASE_URL=http://127.0.0.1:8080
CHAT_MODEL_VERSION=chatbot-kesehatan-qwen2.5-0.5b-q4km

# The student was trained on single-turn data. Set MULTI_TURN=1 only after
# an A/B test on the actual model.
CHAT_MULTI_TURN=0
CHAT_MAX_TURNS=1
CHAT_MAX_TOKENS=320
CHAT_TEMPERATURE=0
CHAT_TOP_P=1
CHAT_TIMEOUT_SECONDS=170

# Leave empty in production when the dashboard is served by this API.
# For the Vite/Node dev server, uncomment:
# CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
CORS_ORIGINS=